# -*- mode: ruby -*-
# vi: set ft=ruby :
require_relative 'provisioning/vbox.rb'
VBoxUtils.check_version('7.2.4')
Vagrant.require_version ">= 2.4.9"

STUDEN_PREFIX = "X"
BOX_NAME = "Y"

Vagrant.configure("2") do |config|
  config.vm.box = BOX_NAME
  config.vm.hostname = "#{STUDEN_PREFIX}-ansible"
  config.vm.network "forwarded_port", guest: 9090, host: 8090
  config.vm.network "forwarded_port", guest: 9100, host: 9100
  config.vm.network "forwarded_port", guest: 3000, host: 3000
  
  # Configure hostmanager plugin
  config.hostmanager.enabled = true
  config.hostmanager.manage_host = true
  config.hostmanager.manage_guest = true

  config.vm.provider "virtualbox" do |vb|
	  vb.name = "AISI-P3-EJ4-#{config.vm.hostname}"
	  vb.cpus = 1
	  vb.memory = 1024
	  vb.gui = false
	  vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
  end

  config.vm.provision "ansible", run: "once", type: "XXX" do |ansible|
	  ansible.install = "XXX"
	  ansible.install_mode = "XXX"
	  ansible.playbook = "XXX"
  end
end
